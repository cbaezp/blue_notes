# ==============================================================================
# NOTE FOR REVIEWERS:
# This .env.local file is deliberately committed to the repository to provide
# an instant, zero-friction, out-of-the-box local development and testing setup.
# Production environments would use secret managers / external env vars.
# ==============================================================================

DEBUG=True
SECRET_KEY=django-insecure-local-dev-secret-key-change-in-production-blue-notes-2026
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,web

# PostgreSQL Configuration
POSTGRES_DB=blue_notes_db
POSTGRES_USER=blue_notes_user
POSTGRES_PASSWORD=blue_notes_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Database URL for Django
DATABASE_URL=postgres://blue_notes_user:blue_notes_password@postgres:5432/blue_notes_db
